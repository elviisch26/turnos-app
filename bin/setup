#!/usr/bin/env ruby.exe
require "fileutils"

# ruta a la raíz de la aplicación.
APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # Este script permite configurar o actualizar automáticamente el entorno de desarrollo.
  # Este script es idempotente, por lo que puede ejecutarse en cualquier momento con un resultado predecible.
  # Agregar los pasos de configuración necesarios a este archivo.

  puts "== Instalación de dependencias =="
  system! "gem install bundler --conservative"
  system("bundle check") || system!("bundle install")

  # puts "\n== Copia de archivos de ejemplo =="
  # unless File.exist?("config/database.yml")
  #   FileUtils.cp "config/database.yml.sample", "config/database.yml"
  # end

  puts "\n== Preparación de la base de datos =="
  system! "bin/rails db:prepare"

  puts "\n== Eliminación de registros y archivos temporales antiguos =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n== Reinicio del servidor de la aplicación =="
  system! "bin/rails restart"
end
