<%# Mostrar formulario para anotarse en lista de espera. %>
<%= form_with model: [slot, waitlist_entry], class: "space-y-4" do |form| %>
  <% if waitlist_entry.errors.any? %>
    <div role="alert" class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      <p class="font-medium">Revisar los datos del formulario:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% waitlist_entry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :customer_name, "Nombre", class: "form-label" %>
    <%= form.text_field :customer_name, required: true, class: "form-input" %>
  </div>

  <div>
    <%= form.label :customer_email, "Correo electrónico", class: "form-label" %>
    <%= form.email_field :customer_email, required: true, class: "form-input" %>
  </div>

  <div>
    <%= form.submit "Anotarse en espera", class: "btn btn-secondary w-full sm:w-auto" %>
  </div>
<% end %>
