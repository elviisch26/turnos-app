<%# Mostrar lista de horarios con capacidad restante. %>
<h1 class="mb-6">Ver horarios</h1>

<% if @slots.empty? %>
  <p class="empty-state">No existir horarios para mostrar.</p>
<% else %>
  <ul class="space-y-3">
    <% @slots.each do |slot| %>
      <li class="card flex flex-wrap items-center justify-between gap-3 p-4">
        <div class="min-w-0">
          <%= link_to "#{slot.service.name} — #{l(slot.starts_at, format: :short)}", slot_path(slot), class: "font-medium text-amber-700 hover:underline" %>
          <p class="mt-0.5 text-sm text-stone-500">capacidad restante: <%= slot.remaining_capacity %> de <%= slot.capacity %></p>
        </div>
        <% if slot.full? %>
          <span class="badge bg-red-100 text-red-700">(completo)</span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<p class="mt-6"><%= link_to "Volver a servicios", services_path, class: "btn btn-secondary" %></p>
