<%# Mostrar capacidad restante del horario. %>
<p class="mb-6 inline-flex flex-wrap items-center gap-2 rounded-full border border-stone-200 bg-white px-4 py-1.5 text-sm text-stone-700 shadow-sm">
  <strong class="font-semibold text-stone-900">Capacidad restante:</strong>
  <span><%= slot.remaining_capacity %> de <%= slot.capacity %></span>
  <% if slot.full? %>
    <span class="badge bg-red-100 text-red-700">(completo)</span>
  <% end %>
</p>
