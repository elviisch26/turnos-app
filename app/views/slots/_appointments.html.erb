<%# Listar reservas confirmadas con botón para cancelar. %>
<% confirmed = slot.appointments.confirmed.order(:created_at) %>
<% if confirmed.empty? %>
  <p class="text-sm text-stone-500">No existir reservas confirmadas.</p>
<% else %>
  <ul class="divide-y divide-stone-100">
    <% confirmed.each do |appointment| %>
      <li class="flex flex-wrap items-center justify-between gap-3 py-3 first:pt-0 last:pb-0">
        <div class="min-w-0">
          <p class="truncate text-sm font-medium text-stone-900"><%= appointment.customer_name %></p>
          <p class="truncate text-sm text-stone-500"><%= appointment.customer_email %></p>
        </div>
        <%= button_to "Cancelar", appointment_path(appointment), method: :delete, class: "btn btn-danger" %>
      </li>
    <% end %>
  </ul>
<% end %>
