<!DOCTYPE html>
<html lang="es">
  <head>
    <title>Peluquería Central</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# "tailwind" resuelve a app/assets/builds/tailwind.css (tailwindcss:build);
        "application" resuelve al manifiesto de sprockets en app/assets/stylesheets. %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body class="flex min-h-screen flex-col bg-stone-50 text-stone-800 antialiased">
    <header class="sticky top-0 z-30 border-b border-stone-200 bg-white/95 backdrop-blur">
      <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6" aria-label="Principal">
        <div class="flex items-baseline gap-3">
          <%= link_to root_path, class: "text-lg font-bold tracking-tight text-stone-900 hover:text-amber-700" do %>
            Peluquería Central
          <% end %>
          <span class="hidden text-sm text-stone-500 sm:inline">Reservar turnos</span>
        </div>

        <div class="flex items-center gap-1 sm:gap-2">
          <%= link_to "Servicios", services_path, class: class_names("nav-link", ("nav-link-active" if current_page?(services_path) || current_page?(root_path))) %>
          <%= link_to "Horarios", slots_path, class: class_names("nav-link", ("nav-link-active" if current_page?(slots_path))) %>
        </div>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6">
      <% if notice.present? %>
        <p role="status" class="flash-success"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p role="alert" class="flash-error"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>

    <footer class="border-t border-stone-200 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-6 text-sm text-stone-500 sm:px-6">
        <p>Peluquería Central</p>
      </div>
    </footer>
  </body>
</html>
